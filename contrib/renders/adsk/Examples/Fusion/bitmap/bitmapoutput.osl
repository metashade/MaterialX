void mx_rotate_vector2(vector2 _in, float amount, output vector2 result)
{
    float rotationRadians = radians(amount);
    float sa = sin(rotationRadians);
    float ca = cos(rotationRadians);
    result = vector2(ca*_in.x + sa*_in.y, -sa*_in.x + ca*_in.y);
}

void NG_switch_vector2I(vector2 in1, vector2 in2, vector2 in3, vector2 in4, vector2 in5, vector2 in6, vector2 in7, vector2 in8, vector2 in9, vector2 in10, int which, output vector2 out)
{
    int ifgreater_10_value1_tmp = 10;
    vector2 ifgreater_10_in2_tmp = vector2(0.000000, 0.000000);
    vector2 ifgreater_10_out = mx_ternary(ifgreater_10_value1_tmp > which, in10, ifgreater_10_in2_tmp);
    int ifgreater_9_value1_tmp = 9;
    vector2 ifgreater_9_out = mx_ternary(ifgreater_9_value1_tmp > which, in9, ifgreater_10_out);
    int ifgreater_8_value1_tmp = 8;
    vector2 ifgreater_8_out = mx_ternary(ifgreater_8_value1_tmp > which, in8, ifgreater_9_out);
    int ifgreater_7_value1_tmp = 7;
    vector2 ifgreater_7_out = mx_ternary(ifgreater_7_value1_tmp > which, in7, ifgreater_8_out);
    int ifgreater_6_value1_tmp = 6;
    vector2 ifgreater_6_out = mx_ternary(ifgreater_6_value1_tmp > which, in6, ifgreater_7_out);
    int ifgreater_5_value1_tmp = 5;
    vector2 ifgreater_5_out = mx_ternary(ifgreater_5_value1_tmp > which, in5, ifgreater_6_out);
    int ifgreater_4_value1_tmp = 4;
    vector2 ifgreater_4_out = mx_ternary(ifgreater_4_value1_tmp > which, in4, ifgreater_5_out);
    int ifgreater_3_value1_tmp = 3;
    vector2 ifgreater_3_out = mx_ternary(ifgreater_3_value1_tmp > which, in3, ifgreater_4_out);
    int ifgreater_2_value1_tmp = 2;
    vector2 ifgreater_2_out = mx_ternary(ifgreater_2_value1_tmp > which, in2, ifgreater_3_out);
    int ifgreater_1_value1_tmp = 1;
    vector2 ifgreater_1_out = mx_ternary(ifgreater_1_value1_tmp > which, in1, ifgreater_2_out);
    out = ifgreater_1_out;
}

void NG_place2d_vector2(vector2 texcoord, vector2 pivot, vector2 scale, float rotate1, vector2 offset, int operationorder, output vector2 out)
{
    vector2 N_subpivot_out = texcoord - pivot;
    vector2 N_applyscale_out = N_subpivot_out / scale;
    vector2 N_applyoffset2_out = N_subpivot_out - offset;
    vector2 N_applyrot_out = vector2(0.0, 0.0);
    mx_rotate_vector2(N_applyscale_out, rotate1, N_applyrot_out);
    vector2 N_applyrot2_out = vector2(0.0, 0.0);
    mx_rotate_vector2(N_applyoffset2_out, rotate1, N_applyrot2_out);
    vector2 N_applyoffset_out = N_applyrot_out - offset;
    vector2 N_applyscale2_out = N_applyrot2_out / scale;
    vector2 N_addpivot_out = N_applyoffset_out + pivot;
    vector2 N_addpivot2_out = N_applyscale2_out + pivot;
    vector2 N_switch_operationorder_out = vector2(0.0, 0.0);
    NG_switch_vector2I(N_addpivot_out, N_addpivot2_out, vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), vector2(0.000000, 0.000000), operationorder, N_switch_operationorder_out);
    out = N_switch_operationorder_out;
}

vector2 mx_transform_uv(vector2 texcoord)
{
    return vector2(texcoord.x, 1.0 - texcoord.y);
}

void mx_image_color3(textureresource file, string layer, color default_value, vector2 texcoord, string uaddressmode, string vaddressmode, string filtertype, string framerange, int frameoffset, string frameendaction, output color out)
{
    if (file.filename == "" ||
        (uaddressmode == "constant" && (texcoord.x<0.0 || texcoord.x>1.0)) ||
        (vaddressmode == "constant" && (texcoord.y<0.0 || texcoord.y>1.0)))
    {
        out = default_value;
        return;
    }

    color missingColor = default_value;
    vector2 st = mx_transform_uv(texcoord);
    out = texture(file.filename, st.x, st.y,
                  "subimage", layer, "interp", filtertype,
                  "missingcolor", missingColor,
                  "swrap", uaddressmode, "twrap", vaddressmode
#if (OSL_VERSION_MAJOR == 1 && OSL_VERSION_MINOR >= 14) || (OSL_VERSION_MAJOR > 1)
                  , "colorspace", file.colorspace
#endif
                  );
}

void adsk_NG_adsk_bitmap_color3(textureresource  file, vector2 realworld_offset, vector2 realworld_scale, vector2 uv_offset, vector2 uv_scale, float rotation_angle, float rgbamount, int invert, string uaddressmode, string vaddressmode, vector2 texcoord, output color out)
{
    vector2 total_offset_out = realworld_offset + uv_offset;
    vector2 total_scale_out = realworld_scale / uv_scale;
    float rotation_angle_param_in2_tmp = -1.000000;
    float rotation_angle_param_out = rotation_angle * rotation_angle_param_in2_tmp;
    vector2 a_place2d_out = vector2(0.0, 0.0);
    NG_place2d_vector2(texcoord, vector2(0.000000, 0.000000), total_scale_out, rotation_angle_param_out, total_offset_out, 1, a_place2d_out);
    color b_image_out = color(0.0);
    mx_image_color3(file, "", color(0.000000, 0.000000, 0.000000), a_place2d_out, uaddressmode, vaddressmode, "linear", "", 0, "constant", b_image_out);
    color image_brightness_out = b_image_out * rgbamount;
    color image_invert_amount_tmp = color(1.000000, 1.000000, 1.000000);
    color image_invert_out = image_invert_amount_tmp - image_brightness_out;
    int image_convert_value2_tmp = 1;
    color image_convert_out = mx_ternary(invert == image_convert_value2_tmp, image_invert_out, image_brightness_out);
    out = image_convert_out;
}

shader bitmapoutput
[[
    string mtlx_category = "output",
    string mtlx_name = "bitmapoutput"
]]
(
    int geomprop_UV0_index = 0
    [[
        string widget = "number"
    ]],
    vector2 simplebitmap_realworld_offset_unit_in1 = {0.000000, 0.000000},
    float simplebitmap_realworld_offset_unit_in2 = 2.540000
    [[
        string widget = "number"
    ]],
    vector2 simplebitmap_realworld_scale_unit_in1 = {2.000000, 2.000000},
    float simplebitmap_realworld_scale_unit_in2 = 2.540000
    [[
        string widget = "number"
    ]],
    string simplebitmap_file = "../../../Images/diagnostic.png"
    [[
        string widget = "filename"
    ]],
    string simplebitmap_file_colorspace = ""
    [[
        string widget = "colorspace"
    ]],
    vector2 simplebitmap_uv_offset = {0.000000, 0.000000},
    vector2 simplebitmap_uv_scale = {1.000000, 1.000000},
    float simplebitmap_rotation_angle = 0.000000
    [[
        string widget = "number"
    ]],
    float simplebitmap_rgbamount = 1.000000
    [[
        string widget = "number"
    ]],
    int simplebitmap_invert = 0
    [[
        string widget = "checkBox"
    ]],
    string simplebitmap_uaddressmode = "periodic",
    string simplebitmap_vaddressmode = "periodic",
    output color bitmapoutput1 = color(0.0)
)
{
    textureresource simplebitmap_file_ = {simplebitmap_file, simplebitmap_file_colorspace};
    vector2 simplebitmap_realworld_offset_unit_out = simplebitmap_realworld_offset_unit_in1 * simplebitmap_realworld_offset_unit_in2;
    vector2 simplebitmap_realworld_scale_unit_out = simplebitmap_realworld_scale_unit_in1 * simplebitmap_realworld_scale_unit_in2;
    vector2 geomprop_UV0_out1 = vector2(u,v);
    color simplebitmap_out = color(0.0);
    adsk_NG_adsk_bitmap_color3(simplebitmap_file_, simplebitmap_realworld_offset_unit_out, simplebitmap_realworld_scale_unit_out, simplebitmap_uv_offset, simplebitmap_uv_scale, simplebitmap_rotation_angle, simplebitmap_rgbamount, simplebitmap_invert, simplebitmap_uaddressmode, simplebitmap_vaddressmode, geomprop_UV0_out1, simplebitmap_out);
    bitmapoutput1 = simplebitmap_out;
}

