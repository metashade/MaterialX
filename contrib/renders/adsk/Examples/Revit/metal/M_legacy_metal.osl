    color invert_col_circ1_amount_tmp = color(1.000000, 1.000000, 1.000000);
    color invert_col_circ1_out = invert_col_circ1_amount_tmp - circles_pattern_regular1_out;
    color invert_col_circ2_amount_tmp = color(1.000000, 1.000000, 1.000000);
    color invert_col_circ2_out = invert_col_circ2_amount_tmp - circles_pattern_staggered1_out;
    color squares_pattern_regular1_out = color(0.0);
    NG_grid_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adj_thickness_out, 0, squares_pattern_regular1_out);
    color squares_pattern_staggered1_out = color(0.0);
    NG_grid_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adj_thickness_out, 1, squares_pattern_staggered1_out);
    color invert_col_hexag_amount_tmp = color(1.000000, 1.000000, 1.000000);
    color invert_col_hexag_out = invert_col_hexag_amount_tmp - tiledhexagons_out;
    color combine_grecian_out = max(squares_pattern_regular2_out, crosshatch_out);
    color invert_col_clover_amount_tmp = color(1.000000, 1.000000, 1.000000);
    color invert_col_clover_out = invert_col_clover_amount_tmp - tiledcloverleafs_out;
    int patina_mask_from_r_index_tmp = 0;
    float patina_mask_from_r_out = mx_extract(patina_noise_output_color3, patina_mask_from_r_index_tmp);
    color switch_cutout1_out = color(0.0);
    NG_switch_color3(invert_col_circ1_out, invert_col_circ2_out, squares_pattern_regular1_out, squares_pattern_staggered1_out, invert_col_hexag_out, color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), modulo_cutout_out, switch_cutout1_out);
    color switch_cutout2_out = color(0.0);
    NG_switch_color3(combine_grecian_out, invert_col_clover_out, custom_cutout, color(0.000000, 0.000000, 0.000000), color(1.000000, 1.000000, 1.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), modulo_cutout_out, switch_cutout2_out);
    float fade_mask_out = patina * patina_mask_from_r_out;
    color switch_cutout_out = color(0.0);
    NG_switch_color3(switch_cutout1_out, switch_cutout2_out, color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(1.000000, 1.000000, 1.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), divide_cutout_out, switch_cutout_out);
    color mix_copper_patina_bg_tmp = color(0.737000, 0.314000, 0.184000);
    color mix_copper_patina_fg_tmp = color(0.136229, 0.231811, 0.083546);
    color mix_copper_patina_out = mix(mix_copper_patina_bg_tmp, mix_copper_patina_fg_tmp, fade_mask_out);
    color mix_bronze_patina_bg_tmp = color(0.412000, 0.302000, 0.231000);
    color mix_bronze_patina_fg_tmp = color(0.053004, 0.099831, 0.024831);
    color mix_bronze_patina_out = mix(mix_bronze_patina_bg_tmp, mix_bronze_patina_fg_tmp, fade_mask_out);
    float range_patina_out = 0.0;
    NG_range_float(fade_mask_out, 0.000000, 1.000000, 1.000000, switch_finish_out, 0.750000, 1, range_patina_out);
    int cutout_selection_value2_tmp = 1;
    color cutout_selection_in2_tmp = color(1.000000, 1.000000, 1.000000);
    color cutout_selection_out = mx_ternary(cutout_enable == cutout_selection_value2_tmp, switch_cutout_out, cutout_selection_in2_tmp);
    color switch_type1_out = color(0.0);
    NG_switch_color3(color(0.957000, 0.957000, 0.957000), custom_color, color(0.957000, 0.957000, 0.957000), mix_copper_patina_out, color(0.796000, 0.604000, 0.231000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), modulo_type_out, switch_type1_out);
    color switch_type2_out = color(0.0);
    NG_switch_color3(mix_bronze_patina_out, color(0.745000, 0.737000, 0.729000), color(0.647000, 0.678000, 0.649000), custom_color, color(0.220900, 0.449300, 0.793800), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), modulo_type_out, switch_type2_out);
    float patina_on_value2_tmp = 0.500000;
    float patina_on_out = mx_ternary(copper_or_bronze_out > patina_on_value2_tmp, range_patina_out, switch_finish_out);
    color switch_type_out = color(0.0);
    NG_switch_color3(switch_type1_out, switch_type2_out, color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), color(0.000000, 0.000000, 0.000000), divide_type_out, switch_type_out);
    color multiply_tint_out = switch_type_out * tint_color;
    int tint_selection_value2_tmp = 1;
    color tint_selection_out = mx_ternary(tint_enable == tint_selection_value2_tmp, multiply_tint_out, switch_type_out);
    surfaceshader stdsurf_legacy_metal_out = surfaceshader(null_closure(), null_closure(), 1.0);
    NG_standard_surface_surfaceshader_100(1.000000, tint_selection_out, 0.000000, 1.000000, 1.000000, tint_selection_out, patina_on_out, 1.500000, 0.000000, 0.000000, 0.000000, color(1.000000, 1.000000, 1.000000), 0.000000, color(0.000000, 0.000000, 0.000000), 0.000000, 0.000000, 0.000000, 0.000000, color(1.000000, 1.000000, 1.000000), color(1.000000, 1.000000, 1.000000), 1.000000, 0.000000, 0.000000, color(1.000000, 1.000000, 1.000000), 0.300000, 0.000000, color(1.000000, 1.000000, 1.000000), 0.100000, 0.000000, 0.000000, 1.500000, geomprop_Nworld_out1, 0.000000, 0.000000, 0.000000, 1.500000, 0.000000, color(1.000000, 1.000000, 1.000000), cutout_selection_out, 0, relief_selection_out, geomprop_Tworld_out1, stdsurf_legacy_metal_out);
    out = stdsurf_legacy_metal_out;
}

void mx_surfacematerial(surfaceshader surface, surfaceshader back, displacementshader disp, output MATERIAL result)
{
    float opacity_weight = clamp(surface.opacity, 0.0, 1.0);
    result =  (surface.bsdf + surface.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
}

void mx_set_ci (
    int output_type,

    // the per-type inputs must be named with "input_<typename>"
    // the of these inputs defines their corresponding output_type value.
    // this is dynamically derived in the shader generation code by
    // inspecting the order of the inputs in the node definition
    surfaceshader input_surfaceshader,
    MATERIAL input_material,
    BSDF input_BSDF,
    EDF input_EDF,
    float input_float,
    color input_color3,
    color4 input_color4,
    vector2 input_vector2,
    vector input_vector3,
    vector4 input_vector4,
    int input_integer,
    int input_boolean,
    matrix input_matrix33,
    matrix input_matrix44,
    displacementshader input_displacementshader,

    output closure color out_ci
)
{
    color c = 0;
    float a = 1;

    if (output_type == 0) {
        float opacity_weight = clamp(input_surfaceshader.opacity, 0.0, 1.0);
        out_ci =  (input_surfaceshader.bsdf + input_surfaceshader.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
    } else if (output_type == 1) {
        out_ci = input_material;
    } else if (output_type == 2) {
        out_ci = input_BSDF;
    } else if (output_type == 3) {
        out_ci = input_EDF;
    } else {
        if (output_type == 4) {
            c = input_float;
        } else if (output_type == 5) {
            c = input_color3;
        } else if (output_type == 6) {
            c = input_color4.rgb;
            a = input_color4.a;
        } else if (output_type == 7) {
            c = color(input_vector2.x, input_vector2.y, 0);
        } else if (output_type == 8) {
            c = color(input_vector3);
        } else if (output_type == 9) {
            c = color(input_vector4.x, input_vector4.y, input_vector4.z);
            a = input_vector4.w;
        } else if (output_type == 10) {
            c = color(input_integer);
        } else if (output_type == 11) {
            c = color(input_boolean);
        } else if (output_type == 12) {
            c = color(input_matrix33[0][0], input_matrix33[1][1], input_matrix33[2][2]);
        } else if (output_type == 13) {
            c = color(input_matrix44[0][0], input_matrix44[1][1], input_matrix44[2][2]);
            a = input_matrix44[4][4];
        } else if (output_type == 14) {
            c = color(input_displacementshader);
        }
        out_ci = c * a * emission() + (1-a) * transparent();
    }

    Ci = out_ci;
}

