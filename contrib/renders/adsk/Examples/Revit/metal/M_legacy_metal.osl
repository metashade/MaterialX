    color tiledcloverleafs_out = color(0.0);
    NG_tiledcloverleafs_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adjust_size_out, 1, tiledcloverleafs_out);
    int relief_selection_value2_tmp = 1;
