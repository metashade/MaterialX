    float ifbronze1_in2_tmp = 0.000000;
    float ifbronze1_out = mx_ternary(type == ifbronze1_value2_tmp, ifbronze1_in1_tmp, ifbronze1_in2_tmp);
    float switch_finish_out = 0.0;
    NG_switch_floatI(0.000000, 0.100000, 0.300000, custom_finish, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, finish, switch_finish_out);
    string geomprop_Nworld_space_tmp = "world";
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space_tmp, N);
    vector2 patterns_texcoord1_out = texcoord;
    float reciprocal_spacing_in1_tmp = 1.000000;
    float reciprocal_spacing_out = reciprocal_spacing_in1_tmp / cutout_spacing;
    float convert_cutout_float_out = float(cutout);
    vector switch_relief_out = vector(0.0);
    NG_switch_vector3I(normal_knurl, normal_diamondplate, normal_checkerplate, normal_custom_relief, vector(0.000000, 0.000000, 0.000000), vector(0.000000, 0.000000, 0.000000), vector(0.000000, 0.000000, 0.000000), vector(0.000000, 0.000000, 0.000000), vector(0.000000, 0.000000, 0.000000), vector(0.000000, 0.000000, 0.000000), relief, switch_relief_out);
    string geomprop_Tworld_space_tmp = "world";
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space_tmp, normalize(dPdu));
    string geomprop_Bworld_space_tmp = "world";
    vector geomprop_Bworld_out1 = transform(geomprop_Bworld_space_tmp, normalize(dPdv));
    float patina_range_out = 0.0;
    NG_range_float(patina, 0.000000, 1.000000, 1.000000, 0.000000, patina_min_out, 0, patina_range_out);
    float modulo_type_in2_tmp = 5.000000;
    float modulo_type_out = mod(convert_type_float_out, modulo_type_in2_tmp);
    float divide_type_in2_tmp = 5.000000;
    float divide_type_out = convert_type_float_out / divide_type_in2_tmp;
    float copper_or_bronze_out = ifcopper1_out + ifbronze1_out;
    vector2 combine_spacing_out = { reciprocal_spacing_out,reciprocal_spacing_out };
    float adjust_size_out = cutout_size * reciprocal_spacing_out;
    float modulo_cutout_in2_tmp = 5.000000;
    float modulo_cutout_out = mod(convert_cutout_float_out, modulo_cutout_in2_tmp);
    float divide_cutout_in2_tmp = 5.000000;
    float divide_cutout_out = convert_cutout_float_out / divide_cutout_in2_tmp;
    vector relief_normalmap_out = vector(0.0);
    mx_normalmap_float(vector(0.500000, 0.500000, 1.000000), 1.000000, geomprop_Nworld_out1, geomprop_Tworld_out1, geomprop_Bworld_out1, relief_normalmap_out);
    float patina_max_in2_tmp = 0.050000;
    float patina_max_out = patina_range_out + patina_max_in2_tmp;
    color circles_pattern_regular1_out = color(0.0);
    NG_tiledcircles_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adjust_size_out, 0, circles_pattern_regular1_out);
    color circles_pattern_staggered1_out = color(0.0);
    NG_tiledcircles_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adjust_size_out, 1, circles_pattern_staggered1_out);
    float adj_thickness_amount_tmp = 1.000000;
    float adj_thickness_out = adj_thickness_amount_tmp - adjust_size_out;
    color tiledhexagons_out = color(0.0);
    NG_tiledhexagons_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adjust_size_out, 1, tiledhexagons_out);
    color squares_pattern_regular2_out = color(0.0);
    NG_grid_color3(patterns_texcoord1_out, combine_spacing_out, vector2(0.000000, 0.000000), adjust_size_out, 0, squares_pattern_regular2_out);
    color crosshatch_out = color(0.0);
