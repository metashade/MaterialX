    ]],
    int SR_legacy_metallicpaint_tint_enable = 0
    [[
        string widget = "checkBox"
    ]],
    color SR_legacy_metallicpaint_tint_color = color(0.200000, 0.200000, 0.800000),
    output MATERIAL out = 0
)
{
    vector geomprop_Pobject_out1 = transform(geomprop_Pobject_space, P);
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space, N);
    surfaceshader SR_legacy_metallicpaint_out = surfaceshader(null_closure(), null_closure(), 1.0);
    NG_legacy_metallicpaint(geomprop_Pobject_out1, SR_legacy_metallicpaint_color, SR_legacy_metallicpaint_specular_color, SR_legacy_metallicpaint_highlight_spread, SR_legacy_metallicpaint_coat_type, SR_legacy_metallicpaint_coat_custom_glossiness, SR_legacy_metallicpaint_coat_custom_ior, SR_legacy_metallicpaint_coat_finish, geomprop_Nworld_out1, SR_legacy_metallicpaint_flakes_enable, SR_legacy_metallicpaint_flakes_size, SR_legacy_metallicpaint_tint_enable, SR_legacy_metallicpaint_tint_color, SR_legacy_metallicpaint_out);
    MATERIAL M_legacy_metallicpaint_out = null_closure();
    mx_surfacematerial(SR_legacy_metallicpaint_out, backsurfaceshader, displacementshader1, M_legacy_metallicpaint_out);
    out = M_legacy_metallicpaint_out;
}

