}

void mx_normalmap_vector2(vector value, vector2 normal_scale, vector N, vector T, vector B, output vector result)
{
    if (value == vector(0.0))
    {
        result = N;
    }
    else
    {
        // The OSL backend uses dPdu and dPdv for tangents and bitangents, but these vectors are not
        // guaranteed to be orthonormal.
        //
        // Orthogonalize the tangent frame using Gram-Schmidt, unlike in the other backends.
        //
        vector v = value * 2.0 - 1.0;
        vector Tn = normalize(T - dot(T, N) * N);
        vector Bn = normalize(B - dot(B, N) * N - dot(B, Tn) * Tn);
        result = normalize(Tn * v[0] * normal_scale.x + Bn * v[1] * normal_scale.y + N * v[2]);
    }
}

void mx_normalmap_float(vector value, float normal_scale, vector N, vector T, vector B, output vector result)
{
    mx_normalmap_vector2(value, vector2(normal_scale, normal_scale), N, T, B, result);
}

void mx_fractal3d_vector3(vector amplitude, int octaves, float lacunarity, float diminish, vector position, output vector result)
{
    vector f = mx_fbm(position, octaves, lacunarity, diminish, "snoise");
    result = f * amplitude;
}

void mx_cellnoise3d_float(vector position, output float result)
{
    // Use the explicit point overload for deterministic 3D cell lookup.
    // Avoid relying on implicit vector conversion in the OSL builtin.
    result = cellnoise(point(position));
}

void mx_cellnoise2d_float(vector2 texcoord, output float result)
{
    result = cellnoise(texcoord.x, texcoord.y);
}

void NG_range_float(float in, float inlow, float inhigh, float gamma, float outlow, float outhigh, int doclamp, output float out)
{
    float N_remap1_float_outlow_tmp = 0.000000;
    float N_remap1_float_outhigh_tmp = 1.000000;
    float N_remap1_float_out = mx_remap(in, inlow, inhigh, N_remap1_float_outlow_tmp, N_remap1_float_outhigh_tmp, 0);
    float N_recip_float_in1_tmp = 1.000000;
    float N_recip_float_out = N_recip_float_in1_tmp / gamma;
    float N_abs_float_out = abs(N_remap1_float_out);
    float N_sign_float_out = sign(N_remap1_float_out);
    float N_pow_float_out = pow(N_abs_float_out, N_recip_float_out);
    float N_gamma_float_out = N_pow_float_out * N_sign_float_out;
    float N_remap2_float_inlow_tmp = 0.000000;
    float N_remap2_float_inhigh_tmp = 1.000000;
    float N_remap2_float_out = mx_remap(N_gamma_float_out, N_remap2_float_inlow_tmp, N_remap2_float_inhigh_tmp, outlow, outhigh, 0);
    float N_clamp_float_out = clamp(N_remap2_float_out, outlow, outhigh);
    int N_switch_float_value2_tmp = 1;
    float N_switch_float_out = mx_ternary(doclamp == N_switch_float_value2_tmp, N_clamp_float_out, N_remap2_float_out);
    out = N_switch_float_out;
}

void NG_randomfloat_float(float in, float min1, float max1, int seed, output float out)
{
    float N_scaleInput_in2_tmp = 4096.000000;
    float N_scaleInput_out = in * N_scaleInput_in2_tmp;
    float N_convertSeed1_out = float(seed);
    vector2 N_combine2_out = { N_scaleInput_out,N_convertSeed1_out };
    float N_cellnoise1_out = 0.0;
    mx_cellnoise2d_float(N_combine2_out, N_cellnoise1_out);
    float N_remapRange_out = 0.0;
    NG_range_float(N_cellnoise1_out, 0.000000, 1.000000, 1.000000, min1, max1, 1, N_remapRange_out);
    out = N_remapRange_out;
}

void mx_rotate_vector3(vector _in, float amount, vector axis, output vector result)
{
    // Based on https://en.wikipedia.org/wiki/Rodrigues%27_rotation_formula, where the
    // Wikipedia formula follows v' = M * v and MaterialX follows v' = v * M, thus the
    // order of parameters to cross are reversed.

    vector nAxis = normalize(axis);
    float rotationRadians = radians(amount);
    float s = sin(rotationRadians);
    float c = cos(rotationRadians);
    float oc = 1.0 - c;
    result = _in * c + cross(_in, nAxis) * s + nAxis * dot(nAxis, _in) * oc;
}

void NG_separate3_vector3(vector in, output float outx, output float outy, output float outz)
{
    int N_extract_0_index_tmp = 0;
    float N_extract_0_out = mx_extract(in, N_extract_0_index_tmp);
    int N_extract_1_index_tmp = 1;
    float N_extract_1_out = mx_extract(in, N_extract_1_index_tmp);
    int N_extract_2_index_tmp = 2;
    float N_extract_2_out = mx_extract(in, N_extract_2_index_tmp);
    outx = N_extract_0_out;
    outy = N_extract_1_out;
    outz = N_extract_2_out;
}

void NG_convert_vector3_color3(vector in, output color out)
{
    float separate_outx = 0.0;
    float separate_outy = 0.0;
    float separate_outz = 0.0;
    NG_separate3_vector3(in, separate_outx, separate_outy, separate_outz);
    color combine_out = color( separate_outx,separate_outy,separate_outz );
    out = combine_out;
}

void NG_legacy_flakes(vector position, color base_color, color specular_color, float size, float divergence, float strenght, float cutoff, output color base_color_out, output color specular_color_out, output color out_rgb, output vector out_vec3, output float out_blend)
{
    color dot_base_color_out = base_color;
    float default_density_in2_tmp = 20.000000;
    vector default_density_out = position * default_density_in2_tmp;
    string geomprop_Nworld_space_tmp = "world";
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space_tmp, N);
    string geomprop_Tworld_space_tmp = "world";
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space_tmp, normalize(dPdu));
    string geomprop_Bworld_space_tmp = "world";
    vector geomprop_Bworld_out1 = transform(geomprop_Bworld_space_tmp, normalize(dPdv));
    vector adjust_size_out = default_density_out / size;
    vector position_noise_out = vector(0.0);
    mx_fractal3d_vector3(vector(0.500000, 0.500000, 0.500000), 2, 2.000000, 0.500000, adjust_size_out, position_noise_out);
    vector position_shift_out = position_noise_out + adjust_size_out;
    float flake_noise_out = 0.0;
    mx_cellnoise3d_float(position_shift_out, flake_noise_out);
    float flake_depth_out = 0.0;
    NG_randomfloat_float(flake_noise_out, 0.000000, 1.000000, 2, flake_depth_out);
    float flake_divergence_out = 0.0;
    NG_randomfloat_float(flake_noise_out, 0.000000, 1.000000, 0, flake_divergence_out);
    float flake_orientation_out = 0.0;
    NG_randomfloat_float(flake_noise_out, 0.000000, 1.000000, 1, flake_orientation_out);
    float depth_cutoff_adjustement_out = 0.0;
    NG_range_float(flake_depth_out, cutoff, 1.000000, 1.250000, 0.000000, 1.000000, 1, depth_cutoff_adjustement_out);
    float divergence_scale_out = flake_divergence_out * divergence;
    float orientation_degrees_in2_tmp = 360.000000;
    float orientation_degrees_out = flake_orientation_out * orientation_degrees_in2_tmp;
    float strenght_adjustment_inlow_tmp = 0.000000;
    float strenght_adjustment_inhigh_tmp = 1.000000;
    float strenght_adjustment_outlow_tmp = 0.000000;
    float strenght_adjustment_out = mx_remap(depth_cutoff_adjustement_out, strenght_adjustment_inlow_tmp, strenght_adjustment_inhigh_tmp, strenght_adjustment_outlow_tmp, strenght, 0);
    float divergence_cutoff_adj_out = divergence_scale_out * depth_cutoff_adjustement_out;
    color mix_specular_out = mix(base_color, specular_color, strenght_adjustment_out);
    vector rotate_divergence_out = vector(0.0);
    mx_rotate_vector3(vector(0.000000, 0.000000, 1.000000), divergence_cutoff_adj_out, vector(0.000000, 1.000000, 0.000000), rotate_divergence_out);
    vector rotate_orientation_out = vector(0.0);
    mx_rotate_vector3(rotate_divergence_out, orientation_degrees_out, vector(0.000000, 0.000000, 1.000000), rotate_orientation_out);
    float divide_half_in2_tmp = 2.000000;
    vector divide_half_out = rotate_orientation_out / divide_half_in2_tmp;
    float offset_half_in2_tmp = 0.500000;
    vector offset_half_out = divide_half_out + offset_half_in2_tmp;
    color convert_vec_col_out = color(0.0);
    NG_convert_vector3_color3(offset_half_out, convert_vec_col_out);
    vector normalmap1_out = vector(0.0);
    mx_normalmap_float(offset_half_out, 1.000000, geomprop_Nworld_out1, geomprop_Tworld_out1, geomprop_Bworld_out1, normalmap1_out);
    base_color_out = dot_base_color_out;
    specular_color_out = mix_specular_out;
    out_rgb = convert_vec_col_out;
    out_vec3 = normalmap1_out;
    out_blend = strenght_adjustment_out;
}

