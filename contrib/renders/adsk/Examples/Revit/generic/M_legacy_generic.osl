    float reflectivity_selection2_in2_tmp = 0.000000;
    float reflectivity_selection2_out = mx_ternary(reflectivity_enable == reflectivity_selection2_value2_tmp, metallic_component_out, reflectivity_selection2_in2_tmp);
    float switch_ior1_out = 0.0;
    NG_switch_float(1.000000, 1.330000, 1.360000, 1.460000, 1.520000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_ior_out, switch_ior1_out);
    float switch_ior2_out = 0.0;
    NG_switch_float(2.300000, custom_refraction, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_ior_out, switch_ior2_out);
    int transparency_selection_value2_tmp = 1;
    float transparency_selection_in2_tmp = 0.000000;
