    float switch_luminance1_out = 0.0;
    NG_switch_float(10.000000, 100.000000, 140.000000, 200.000000, 250.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_luminance_out, switch_luminance1_out);
    float switch_luminance2_out = 0.0;
    NG_switch_float(1300.000000, 2500.000000, 10000.000000, 20000.000000, 210000.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_luminance_out, switch_luminance2_out);
    float switch_luminance3_out = 0.0;
    NG_switch_float(custom_luminance, 2.400000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_luminance_out, switch_luminance3_out);
    float switch_K1_out = 0.0;
    NG_switch_float(1850.000000, 2800.000000, 3400.000000, 4100.000000, 5000.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_K_out, switch_K1_out);
    float switch_K2_out = 0.0;
