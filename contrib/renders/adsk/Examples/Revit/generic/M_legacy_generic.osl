    int bump_selection_value2_tmp = 1;
    vector bump_selection_out = mx_ternary(bump_enable == bump_selection_value2_tmp, normalmap1_out, neutral_normalmap_out);
    int tint_selection_value2_tmp = 1;
    color tint_selection_out = mx_ternary(tint_enable == tint_selection_value2_tmp, tint_mult_out, diffuse_image_selection_out);
    float switch_ior_out = 0.0;
    NG_switch_float(switch_ior1_out, switch_ior2_out, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, divide_ior_out, switch_ior_out);
    float switch_luminance_out = 0.0;
