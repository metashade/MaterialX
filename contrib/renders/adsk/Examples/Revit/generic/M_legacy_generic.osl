    float modulo_luminance_in2_tmp = 5.000000;
    float modulo_luminance_out = mod(convert_em_float_out, modulo_luminance_in2_tmp);
    float divide_luminance_in2_tmp = 5.000000;
    float divide_luminance_out = convert_em_float_out / divide_luminance_in2_tmp;
    float modulo_K_in2_tmp = 5.000000;
    float modulo_K_out = mod(convert_K_float_out, modulo_K_in2_tmp);
