    string geomprop_Bworld_space_tmp = "world";
    vector geomprop_Bworld_out1 = transform(geomprop_Bworld_space_tmp, normalize(dPdv));
    int diffuse_image_selection_value2_tmp = 1;
    color diffuse_image_selection_out = mx_ternary(diffuse_image_enable == diffuse_image_selection_value2_tmp, diffuse_image_mix_out, diffuse_color);
    float metallic_component_value2_tmp = 0.100000;
    float metallic_component_in2_tmp = 0.000000;
    float metallic_component_out = mx_ternary(reflectivity > metallic_component_value2_tmp, refl_extr_out, metallic_component_in2_tmp);
    float modulo_ior_in2_tmp = 5.000000;
    float modulo_ior_out = mod(convert_ior_float_out, modulo_ior_in2_tmp);
    float divide_ior_in2_tmp = 5.000000;
    float divide_ior_out = convert_ior_float_out / divide_ior_in2_tmp;
