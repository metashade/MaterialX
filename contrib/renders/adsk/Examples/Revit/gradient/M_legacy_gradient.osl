    float p1_out = noise_low + multiply8_out;
    float p2_out = noise_high - multiply8_out;
    float multiply9_in2_tmp = 2.000000;
    float multiply9_out = multiply8_out * multiply9_in2_tmp;
    vector2 modulo1_in2_tmp = vector2(1.000000, 1.000000);
    vector2 modulo1_out = mod(trim_coord_out, modulo1_in2_tmp);
    float separate_uv_outx = 0.0;
    float separate_uv_outy = 0.0;
    NG_separate2_vector2(trim_coord_out, separate_uv_outx, separate_uv_outy);
    float separate_texcoord_outx = 0.0;
    float separate_texcoord_outy = 0.0;
    NG_separate2_vector2(modulo1_out, separate_texcoord_outx, separate_texcoord_outy);
    float subtract3_in2_tmp = 0.500000;
    vector2 subtract3_out = modulo1_out - subtract3_in2_tmp;
    float subtract4_in2_tmp = 0.500000;
    vector2 subtract4_out = modulo1_out - subtract4_in2_tmp;
    float subtract5_in2_tmp = 0.500000;
    vector2 subtract5_out = modulo1_out - subtract5_in2_tmp;
    float subtract7_in2_tmp = 0.500000;
    vector2 subtract7_out = modulo1_out - subtract7_in2_tmp;
    vector2 noise_size_vec2_out = modulo1_out * noise_size1_out;
    float ifgreater_1_u_value2_tmp = 1.000000;
    float ifgreater_1_u_in1_tmp = 0.000000;
    float ifgreater_1_u_in2_tmp = 1.000000;
    float ifgreater_1_u_out = mx_ternary(separate_uv_outx > ifgreater_1_u_value2_tmp, ifgreater_1_u_in1_tmp, ifgreater_1_u_in2_tmp);
