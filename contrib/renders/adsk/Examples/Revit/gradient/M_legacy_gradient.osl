    float separate2_4_outx = 0.0;
    float separate2_4_outy = 0.0;
    NG_separate2_vector2(subtract5_out, separate2_4_outx, separate2_4_outy);
    vector2 absval4_out = abs(subtract7_out);
    vector2 add1_in2_tmp = vector2(1.000000, 1.000000);
    vector2 add1_out = noise_size_vec2_out + add1_in2_tmp;
    float ifgreatereq_0_u_value2_tmp = 0.000000;
