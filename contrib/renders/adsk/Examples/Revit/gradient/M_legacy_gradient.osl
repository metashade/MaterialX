    int tile_y_enable_value2_tmp = 1;
    float tile_y_enable_in1_tmp = 1.000000;
    float tile_y_enable_out = mx_ternary(tile_y == tile_y_enable_value2_tmp, tile_y_enable_in1_tmp, ifgreatereq_0_v_out);
    float ifgreater1_value2_tmp = 0.000000;
    float ifgreater1_out = mx_ternary(separate_texcoord_outx > ifgreater1_value2_tmp, divide1_out, separate_texcoord_outy);
    float magnitude1_out = length(combine2_1_out);
    float ifgreater3_value2_tmp = 1.000000;
    float ifgreater3_out = mx_ternary(divide3_out > ifgreater3_value2_tmp, ifgreater4_out, divide3_out);
    float separate2_5_outx = 0.0;
    float separate2_5_outy = 0.0;
    NG_separate2_vector2(normalize2_out, separate2_5_outx, separate2_5_outy);
    float separate2_2_outx = 0.0;
    float separate2_2_outy = 0.0;
    NG_separate2_vector2(multiply3_out, separate2_2_outx, separate2_2_outy);
    float min3_in2_tmp = 1.000000;
    float min3_out = min(magnitude2_out, min3_in2_tmp);
    vector2 normalize1_out = normalize(combine2_2_out);
    float separate2_6_outx = 0.0;
    float separate2_6_outy = 0.0;
    NG_separate2_vector2(multiply5_out, separate2_6_outx, separate2_6_outy);
    vector combine_3d_coord_out = vector( separate_2d_coord_outx,separate_2d_coord_outy,noise_phase );
    float combine_tiling_out = tile_x_enable_out * tile_y_enable_out;
    float ifgreater2_value2_tmp = 0.000000;
    float ifgreater2_in2_tmp = 0.000000;
    float ifgreater2_out = mx_ternary(separate_texcoord_outy > ifgreater2_value2_tmp, ifgreater3_out, ifgreater2_in2_tmp);
    float acos2_out = acos(separate2_5_outx);
    float max1_out = max(separate2_2_outx, separate2_2_outy);
    float separate2_3_outx = 0.0;
    float separate2_3_outy = 0.0;
    NG_separate2_vector2(normalize1_out, separate2_3_outx, separate2_3_outy);
    float min6_out = min(separate2_6_outx, separate2_6_outy);
    float fractal3d_max8_1_out = 0.0;
    NG_fractal3d_max8_float(combine_3d_coord_out, noise_levels, 1.000000, fractal3d_max8_1_out);
    float turbulence3d1_out = 0.0;
    NG_turbulence3d_max8_float(combine_3d_coord_out, noise_levels, 1.000000, turbulence3d1_out);
    float min2_in2_tmp = 1.000000;
    float min2_out = min(ifgreater2_out, min2_in2_tmp);
    float divide6_in2_tmp = 1.570800;
    float divide6_out = acos2_out / divide6_in2_tmp;
    float min1_in2_tmp = 1.000000;
    float min1_out = min(max1_out, min1_in2_tmp);
    float acos1_out = acos(separate2_3_outx);
    float min7_in2_tmp = 1.000000;
    float min7_out = min(min6_out, min7_in2_tmp);
    float noise_select_out = 0.0;
    NG_switch_floatI(noise_simple_out, fractal3d_max8_1_out, turbulence3d1_out, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, noise_type, noise_select_out);
    float min5_in2_tmp = 1.000000;
    float min5_out = min(divide6_out, min5_in2_tmp);
    float switch_type1_out = 0.0;
    NG_switch_float(separate_texcoord_outx, separate_texcoord_outy, ifgreater1_out, min1_out, magnitude1_out, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_type_out, switch_type1_out);
    float subtract6_in1_tmp = 6.283190;
    float subtract6_out = subtract6_in1_tmp - acos1_out;
    float invert1_amount_tmp = 1.000000;
    float invert1_out = invert1_amount_tmp - min7_out;
    float add2_in2_tmp = 1.000000;
    float add2_out = noise_select_out + add2_in2_tmp;
    float ifgreater5_value2_tmp = 0.000000;
    float ifgreater5_out = mx_ternary(separate2_3_outy > ifgreater5_value2_tmp, subtract6_out, acos1_out);
    float value1_in2_tmp = 0.500000;
    float value1_out = add2_out * value1_in2_tmp;
    float divide5_in2_tmp = 6.283190;
    float divide5_out = ifgreater5_out / divide5_in2_tmp;
    float ifgreater8_in1_tmp = 0.000000;
    float ifgreater8_in2_tmp = 1.000000;
    float ifgreater8_out = mx_ternary(p0_out > value1_out, ifgreater8_in1_tmp, ifgreater8_in2_tmp);
    float subtract9_out = value1_out - p0_out;
    float subtract10_out = p3_out - value1_out;
    float min4_in2_tmp = 1.000000;
    float min4_out = min(divide5_out, min4_in2_tmp);
    float ifgreatereq1_in1_tmp = 2.000000;
    float ifgreatereq1_out = mx_ternary(value1_out >= p1_out, ifgreatereq1_in1_tmp, ifgreater8_out);
    float divide7_out = subtract9_out / multiply9_out;
    float divide8_out = subtract10_out / multiply9_out;
    float switch_type2_out = 0.0;
    NG_switch_float(min2_out, min3_out, min4_out, min5_out, invert1_out, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, modulo_type_out, switch_type2_out);
    float ifgreater9_in1_tmp = 3.000000;
    float ifgreater9_out = mx_ternary(value1_out > p2_out, ifgreater9_in1_tmp, ifgreatereq1_out);
    float multiply11_out = divide7_out * divide7_out;
    float multiply13_out = divide8_out * divide8_out;
    float switch_type_out = 0.0;
    NG_switch_float(switch_type1_out, switch_type2_out, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, divide_type_out, switch_type_out);
    float ifgreatereq3_in1_tmp = 4.000000;
    float ifgreatereq3_out = mx_ternary(value1_out >= p3_out, ifgreatereq3_in1_tmp, ifgreater9_out);
    float multiply12_out = multiply11_out * multiply8_out;
    float multiply14_out = multiply13_out * multiply8_out;
    float add3_out = noise_low + multiply12_out;
    float subtract11_out = noise_high - multiply14_out;
    float switch4_out = 0.0;
    NG_switch_float(noise_low, add3_out, value1_out, subtract11_out, noise_high, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, ifgreatereq3_out, switch4_out);
    float multiply10_in2_tmp = 2.000000;
    float multiply10_out = switch4_out * multiply10_in2_tmp;
    float value2_in2_tmp = 1.000000;
    float value2_out = multiply10_out - value2_in2_tmp;
    float noiseamount_mult_out = value2_out * noise_amount;
    float add_noise_out = switch_type_out + noiseamount_mult_out;
    int noise_enable1_value2_tmp = 1;
    float noise_enable1_out = mx_ternary(noise_enable == noise_enable1_value2_tmp, add_noise_out, switch_type_out);
    float clamp1_low_tmp = 0.000000;
