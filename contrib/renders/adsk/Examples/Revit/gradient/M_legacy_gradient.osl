    vector2 normalize2_out = normalize(combine2_3_out);
    float multiply3_in2_tmp = 2.000000;
    vector2 multiply3_out = absval3_out * multiply3_in2_tmp;
    float magnitude2_out = length(multiply4_out);
    vector2 combine2_2_out = { separate2_4_outy,separate2_4_outx };
