void NG_legacy_gradient_float(vector2 texcoord, int type, vector2 realworld_scale, int noise_enable, int noise_type, float noise_amount, float noise_size, float noise_smooth, float noise_low, float noise_high, float noise_levels, float noise_phase, vector2 realworld_offset, float rotation_angle, int tile_x, int tile_y, output float out)
{
