    float ifgreater_1_v_in1_tmp = 0.000000;
    float ifgreater_1_v_in2_tmp = 1.000000;
    float ifgreater_1_v_out = mx_ternary(separate_uv_outy > ifgreater_1_v_value2_tmp, ifgreater_1_v_in1_tmp, ifgreater_1_v_in2_tmp);
    float multiply2_out = separate_texcoord_outx * separate_texcoord_outx;
    float multiply1_out = separate_texcoord_outy * separate_texcoord_outy;
    float subtract1_out = separate_texcoord_outy - separate_texcoord_outx;
    float subtract2_out = separate_texcoord_outx - separate_texcoord_outy;
    float divide3_out = separate_texcoord_outx / separate_texcoord_outy;
    float divide4_out = separate_texcoord_outy / separate_texcoord_outx;
    vector2 combine2_3_out = { separate_texcoord_outy,separate_texcoord_outx };
