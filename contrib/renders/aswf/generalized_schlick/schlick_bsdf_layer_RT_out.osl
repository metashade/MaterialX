#include "mx_funcs.h"

#define true 1
#define false 0
struct textureresource { string filename; string colorspace; };
#define BSDF closure color
#define EDF closure color
#define VDF closure color
struct surfaceshader { closure color bsdf; closure color edf; float opacity; };
#define volumeshader closure color
#define displacementshader vector
#define lightshader closure color
#define MATERIAL closure color

#define M_FLOAT_EPS 1e-8
closure color null_closure() { closure color null_closure = 0; return null_closure; } 

void mx_generalized_schlick_bsdf(float weight, color color0, color color82, color color90, float exponent, vector2 roughness, int retroreflective, float thinfilm_thickness, float thinfilm_ior, normal N, vector U, string distribution, string scatter_mode, output BSDF bsdf)
{
    color reflection_tint = (scatter_mode == "T") ? color(0.0) : color(1.0);
    color transmission_tint = (scatter_mode == "R") ? color(0.0) : color(1.0);
    bsdf = weight * generalized_schlick_bsdf(N, U, reflection_tint, transmission_tint, roughness.x, roughness.y, color0, color90, exponent, distribution, "thinfilm_thickness", thinfilm_thickness, "thinfilm_ior", thinfilm_ior);
}

void mx_surface(BSDF bsdf, EDF edf, float opacity, int thin_walled, output surfaceshader result)
{
    result.bsdf    = bsdf;
    result.edf     = edf;
    result.opacity = clamp(opacity, 0.0, 1.0);
}

void mx_surfacematerial(surfaceshader surface, surfaceshader back, displacementshader disp, output MATERIAL result)
{
    float opacity_weight = clamp(surface.opacity, 0.0, 1.0);
    result =  (surface.bsdf + surface.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
}

shader layer_RT_out
[[
    string mtlx_category = "output",
    string mtlx_name = "layer_RT_out"
]]
(
    string geomprop_Nworld_space = "world",
    string geomprop_Tworld_space = "world",
    int geomprop_Tworld_index = 0
    [[
        string widget = "number"
    ]],
    float schlick_R_weight = 1.000000
    [[
        string widget = "number"
    ]],
    color schlick_R_color0 = color(0.800000, 0.800000, 0.800000),
    color schlick_R_color82 = color(1.000000, 1.000000, 1.000000),
    color schlick_R_color90 = color(1.000000, 1.000000, 1.000000),
    float schlick_R_exponent = 5.000000
    [[
        string widget = "number"
    ]],
    vector2 schlick_R_roughness = {0.020000, 0.020000},
    int schlick_R_retroreflective = 0
    [[
        string widget = "checkBox"
    ]],
    float schlick_R_thinfilm_thickness = 0.000000
    [[
        string widget = "number"
    ]],
    float schlick_R_thinfilm_ior = 1.500000
    [[
        string widget = "number"
    ]],
    string schlick_R_distribution = "ggx",
    string schlick_R_scatter_mode = "R",
    float schlick_T_weight = 1.000000
    [[
        string widget = "number"
    ]],
    color schlick_T_color0 = color(0.200000, 0.200000, 0.200000),
    color schlick_T_color82 = color(1.000000, 1.000000, 1.000000),
    color schlick_T_color90 = color(1.000000, 1.000000, 1.000000),
    float schlick_T_exponent = 5.000000
    [[
        string widget = "number"
    ]],
    vector2 schlick_T_roughness = {0.020000, 0.020000},
    int schlick_T_retroreflective = 0
    [[
        string widget = "checkBox"
    ]],
    float schlick_T_thinfilm_thickness = 0.000000
    [[
        string widget = "number"
    ]],
    float schlick_T_thinfilm_ior = 1.500000
    [[
        string widget = "number"
    ]],
    string schlick_T_distribution = "ggx",
    string schlick_T_scatter_mode = "T",
    float surface_layer_RT_opacity = 1.000000
    [[
        string widget = "number"
    ]],
    int surface_layer_RT_thin_walled = 0
    [[
        string widget = "checkBox"
    ]],
    output MATERIAL layer_RT_out1 = 0
)
{
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space, N);
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space, normalize(dPdu));
    BSDF schlick_R_out = null_closure();
    mx_generalized_schlick_bsdf(schlick_R_weight, schlick_R_color0, schlick_R_color82, schlick_R_color90, schlick_R_exponent, schlick_R_roughness, schlick_R_retroreflective, schlick_R_thinfilm_thickness, schlick_R_thinfilm_ior, geomprop_Nworld_out1, geomprop_Tworld_out1, schlick_R_distribution, schlick_R_scatter_mode, schlick_R_out);
    BSDF schlick_T_out = null_closure();
    mx_generalized_schlick_bsdf(schlick_T_weight, schlick_T_color0, schlick_T_color82, schlick_T_color90, schlick_T_exponent, schlick_T_roughness, schlick_T_retroreflective, schlick_T_thinfilm_thickness, schlick_T_thinfilm_ior, geomprop_Nworld_out1, geomprop_Tworld_out1, schlick_T_distribution, schlick_T_scatter_mode, schlick_T_out);
    BSDF layer_RT_out2 = layer(schlick_R_out, schlick_T_out);
    surfaceshader surface_layer_RT_out = surfaceshader(null_closure(), null_closure(), 1.0);
    mx_surface(layer_RT_out2, null_closure(), surface_layer_RT_opacity, surface_layer_RT_thin_walled, surface_layer_RT_out);
    MATERIAL _surfacematerial__out = null_closure();
    mx_surfacematerial(surface_layer_RT_out, surfaceshader(null_closure(), null_closure(), 1.0), vector(0.0), _surfacematerial__out);
    layer_RT_out1 = _surfacematerial__out;
}

