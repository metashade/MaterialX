#include "mx_funcs.h"

#define true 1
#define false 0
struct textureresource { string filename; string colorspace; };
#define BSDF closure color
#define EDF closure color
#define VDF closure color
struct surfaceshader { closure color bsdf; closure color edf; float opacity; };
#define volumeshader closure color
#define displacementshader vector
#define lightshader closure color
#define MATERIAL closure color

#define M_FLOAT_EPS 1e-8
closure color null_closure() { closure color null_closure = 0; return null_closure; } 

void IMP_substratebsdf(color albedo, color subsurface1, float subsurface_weight, output BSDF out)
{
    string geomprop_Nworld_space_tmp = "world";
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space_tmp, N);
    float diffuse_weight_tmp = 1.000000;
    float diffuse_roughness_tmp = 0.000000;
    BSDF diffuse_out = diffuse_weight_tmp * oren_nayar_diffuse_bsdf(geomprop_Nworld_out1, albedo, diffuse_roughness_tmp);
    float subsurface2_weight_tmp = 1.000000;
    BSDF subsurface2_out = subsurface2_weight_tmp * translucent_bsdf(geomprop_Nworld_out1, subsurface1);
    BSDF mix1_out = mix(subsurface2_out, diffuse_out, subsurface_weight);
    out = mix1_out;
}

void mx_surface(BSDF bsdf, EDF edf, float opacity, int thin_walled, output surfaceshader result)
{
    result.bsdf    = bsdf;
    result.edf     = edf;
    result.opacity = clamp(opacity, 0.0, 1.0);
}

void IMP_substrateshader(color albedo, color subsurface1, float subsurface_weight, color emission1, float opacity, output surfaceshader out)
{
    BSDF substrate1_out = null_closure();
    IMP_substratebsdf(albedo, subsurface1, subsurface_weight, substrate1_out);
    EDF edf1_out = uniform_edf(emission1);
    surfaceshader surface1_out = surfaceshader(null_closure(), null_closure(), 1.0);
    mx_surface(substrate1_out, edf1_out, opacity, 0, surface1_out);
    out = surface1_out;
}

void mx_surfacematerial(surfaceshader surface, surfaceshader back, displacementshader disp, output MATERIAL result)
{
    float opacity_weight = clamp(surface.opacity, 0.0, 1.0);
    result =  (surface.bsdf + surface.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
}

shader out
[[
    string mtlx_category = "output",
    string mtlx_name = "out"
]]
(
    color shader1_albedo = color(0.800000, 0.200000, 0.100000),
    color shader1_subsurface = color(0.100000, 0.100000, 0.800000),
    float shader1_subsurface_weight = 0.000000
    [[
        string widget = "number"
    ]],
    color shader1_emission = color(0.000000, 0.000000, 0.000000),
    float shader1_opacity = 1.000000
    [[
        string widget = "number"
    ]],
    output MATERIAL out1 = 0
)
{
    surfaceshader shader1_out = surfaceshader(null_closure(), null_closure(), 1.0);
    IMP_substrateshader(shader1_albedo, shader1_subsurface, shader1_subsurface_weight, shader1_emission, shader1_opacity, shader1_out);
    MATERIAL _surfacematerial__out = null_closure();
    mx_surfacematerial(shader1_out, surfaceshader(null_closure(), null_closure(), 1.0), vector(0.0), _surfacematerial__out);
    out1 = _surfacematerial__out;
}

