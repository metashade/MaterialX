#include "mx_funcs.h"

#define true 1
#define false 0
struct textureresource { string filename; string colorspace; };
#define BSDF closure color
#define EDF closure color
#define VDF closure color
struct surfaceshader { closure color bsdf; closure color edf; float opacity; };
#define volumeshader closure color
#define displacementshader vector
#define lightshader closure color
#define MATERIAL closure color

#define M_FLOAT_EPS 1e-8
closure color null_closure() { closure color null_closure = 0; return null_closure; } 

void mx_dielectric_bsdf(float weight, color tint, float ior, vector2 roughness, int retroreflective, float thinfilm_thickness, float thinfilm_ior, normal N, vector U, string distribution, string scatter_mode, output BSDF bsdf)
{
    color reflection_tint = (scatter_mode == "T") ? color(0.0) : tint;
    color transmission_tint = (scatter_mode == "R") ? color(0.0) : tint;
    bsdf = weight * dielectric_bsdf(N, U, reflection_tint, transmission_tint, roughness.x, roughness.y, ior, distribution, "thinfilm_thickness", thinfilm_thickness, "thinfilm_ior", thinfilm_ior);
}

void mx_surface(BSDF bsdf, EDF edf, float opacity, int thin_walled, output surfaceshader result)
{
    result.bsdf    = bsdf;
    result.edf     = edf;
    result.opacity = clamp(opacity, 0.0, 1.0);
}

void IMP_foo_surface(float ior, vector2 roughness, output surfaceshader out)
{
    string geomprop_Nworld_space_tmp = "world";
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space_tmp, N);
    string geomprop_Tworld_space_tmp = "world";
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space_tmp, normalize(dPdu));
    BSDF dielectric_brdf_1__layer_top_out = null_closure();
    mx_dielectric_bsdf(1.000000, color(1.000000, 1.000000, 1.000000), ior, roughness, 0, 0.000000, 1.500000, geomprop_Nworld_out1, geomprop_Tworld_out1, "ggx", "R", dielectric_brdf_1__layer_top_out);
    BSDF dielectric_btdf_1_out = null_closure();
    mx_dielectric_bsdf(1.000000, color(1.000000, 1.000000, 1.000000), ior, roughness, 0, 0.000000, 1.500000, geomprop_Nworld_out1, geomprop_Tworld_out1, "ggx", "T", dielectric_btdf_1_out);
    BSDF dielectric_brdf_1_out = layer(dielectric_brdf_1__layer_top_out, dielectric_btdf_1_out);
    surfaceshader surface1_out = surfaceshader(null_closure(), null_closure(), 1.0);
    mx_surface(dielectric_brdf_1_out, null_closure(), 1.000000, 0, surface1_out);
    out = surface1_out;
}

void mx_surfacematerial(surfaceshader surface, surfaceshader back, displacementshader disp, output MATERIAL result)
{
    float opacity_weight = clamp(surface.opacity, 0.0, 1.0);
    result =  (surface.bsdf + surface.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
}

shader varying_ior_test1_mtrl
[[
    string mtlx_category = "surfacematerial",
    string mtlx_name = "varying_ior_test1_mtrl"
]]
(
    surfaceshader backsurfaceshader = { 0, 0, 1.0 },
    displacementshader displacementshader1 = vector(0.0),
    int texcoord1_index = 0
    [[
        string widget = "number"
    ]],
    int texcoord1_x_index = 0
    [[
        string widget = "number"
    ]],
    vector2 varying_ior_test1_roughness = {0.100000, 0.100000},
    output MATERIAL out = 0
)
{
    vector2 texcoord1_out = vector2(u,v);
    float texcoord1_x_out = mx_extract(texcoord1_out, texcoord1_x_index);
    surfaceshader varying_ior_test1_out = surfaceshader(null_closure(), null_closure(), 1.0);
    IMP_foo_surface(texcoord1_x_out, varying_ior_test1_roughness, varying_ior_test1_out);
    MATERIAL varying_ior_test1_mtrl_out = null_closure();
    mx_surfacematerial(varying_ior_test1_out, backsurfaceshader, displacementshader1, varying_ior_test1_mtrl_out);
    out = varying_ior_test1_mtrl_out;
}

