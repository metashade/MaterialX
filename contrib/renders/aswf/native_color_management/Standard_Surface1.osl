}

void NG_adobergb_to_lin_rec709_color3(color in, output color out)
{
    float max_in2_tmp = 0.000000;
    color max_out = max(in, max_in2_tmp);
    float constant_in1_tmp = 563.000000;
    float constant_in2_tmp = 256.000000;
    float constant_out = constant_in1_tmp / constant_in2_tmp;
    color gamma_out = pow(max_out, constant_out);
    color rec709_out = color(0.0);
    NG_lin_adobergb_to_lin_rec709_color3(gamma_out, rec709_out);
    out = rec709_out;
}

