void NG_g18_rec709_to_lin_rec709_color3(color in, output color out)
{
    float max_in2_tmp = 0.000000;
    color max_out = max(in, max_in2_tmp);
    float gamma_in2_tmp = 1.800000;
    color gamma_out = pow(max_out, gamma_in2_tmp);
    out = gamma_out;
}

