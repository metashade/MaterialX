#include "mx_funcs.h"

#define true 1
#define false 0
struct textureresource { string filename; string colorspace; };
#define BSDF closure color
#define EDF closure color
#define VDF closure color
struct surfaceshader { closure color bsdf; closure color edf; float opacity; };
#define volumeshader closure color
#define displacementshader vector
#define lightshader closure color
#define MATERIAL closure color

#define M_FLOAT_EPS 1e-8
closure color null_closure() { closure color null_closure = 0; return null_closure; } 

void mx_dielectric_bsdf(float weight, color tint, float ior, vector2 roughness, int retroreflective, float thinfilm_thickness, float thinfilm_ior, normal N, vector U, string distribution, string scatter_mode, output BSDF bsdf)
{
    color reflection_tint = (scatter_mode == "T") ? color(0.0) : tint;
    color transmission_tint = (scatter_mode == "R") ? color(0.0) : tint;
    bsdf = weight * dielectric_bsdf(N, U, reflection_tint, transmission_tint, roughness.x, roughness.y, ior, distribution, "thinfilm_thickness", thinfilm_thickness, "thinfilm_ior", thinfilm_ior);
}

void IMP_mybsdf(float diffuse1, color diffuseColor, float specular, color specularColor, output BSDF out)
{
    string geomprop_Nworld_space_tmp = "world";
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space_tmp, N);
    string geomprop_Tworld_space_tmp = "world";
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space_tmp, normalize(dPdu));
    BSDF dielectric_brdf1_out = null_closure();
    mx_dielectric_bsdf(specular, specularColor, 1.520000, vector2(0.050000, 0.050000), 0, 0.000000, 1.500000, geomprop_Nworld_out1, geomprop_Tworld_out1, "ggx", "R", dielectric_brdf1_out);
    float diffuse_brdf1_roughness_tmp = 0.000000;
    BSDF diffuse_brdf1_out = diffuse1 * oren_nayar_diffuse_bsdf(geomprop_Nworld_out1, diffuseColor, diffuse_brdf1_roughness_tmp);
    BSDF layer1_out = layer(dielectric_brdf1_out, diffuse_brdf1_out);
    out = layer1_out;
}

void mx_surface(BSDF bsdf, EDF edf, float opacity, int thin_walled, output surfaceshader result)
{
    result.bsdf    = bsdf;
    result.edf     = edf;
    result.opacity = clamp(opacity, 0.0, 1.0);
}

void mx_surfacematerial(surfaceshader surface, surfaceshader back, displacementshader disp, output MATERIAL result)
{
    float opacity_weight = clamp(surface.opacity, 0.0, 1.0);
    result =  (surface.bsdf + surface.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
}

shader out
[[
    string mtlx_category = "output",
    string mtlx_name = "out"
]]
(
    string geomprop_Nworld_space = "world",
    string geomprop_Tworld_space = "world",
    int geomprop_Tworld_index = 0
    [[
        string widget = "number"
    ]],
    float mybsdf1_diffuse = 0.400000
    [[
        string widget = "number"
    ]],
    color mybsdf1_diffuseColor = color(1.000000, 0.100000, 0.100000),
    float mybsdf1_specular = 1.000000
    [[
        string widget = "number"
    ]],
    color mybsdf1_specularColor = color(1.000000, 1.000000, 1.000000),
    float dielectric_brdf1_weight = 1.000000
    [[
        string widget = "number"
    ]],
    color dielectric_brdf1_tint = color(1.000000, 1.000000, 1.000000),
    float dielectric_brdf1_ior = 1.900000
    [[
        string widget = "number"
    ]],
    vector2 dielectric_brdf1_roughness = {0.050000, 0.050000},
    int dielectric_brdf1_retroreflective = 0
    [[
        string widget = "checkBox"
    ]],
    float dielectric_brdf1_thinfilm_thickness = 0.000000
    [[
        string widget = "number"
    ]],
    float dielectric_brdf1_thinfilm_ior = 1.500000
    [[
        string widget = "number"
    ]],
    string dielectric_brdf1_distribution = "ggx",
    string dielectric_brdf1_scatter_mode = "R",
    float surface1_opacity = 1.000000
    [[
        string widget = "number"
    ]],
    int surface1_thin_walled = 0
    [[
        string widget = "checkBox"
    ]],
    output MATERIAL out1 = 0
)
{
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space, N);
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space, normalize(dPdu));
    BSDF dielectric_brdf1_out = null_closure();
    mx_dielectric_bsdf(dielectric_brdf1_weight, dielectric_brdf1_tint, dielectric_brdf1_ior, dielectric_brdf1_roughness, dielectric_brdf1_retroreflective, dielectric_brdf1_thinfilm_thickness, dielectric_brdf1_thinfilm_ior, geomprop_Nworld_out1, geomprop_Tworld_out1, dielectric_brdf1_distribution, dielectric_brdf1_scatter_mode, dielectric_brdf1_out);
    BSDF mybsdf1_out = null_closure();
    IMP_mybsdf(mybsdf1_diffuse, mybsdf1_diffuseColor, mybsdf1_specular, mybsdf1_specularColor, mybsdf1_out);
    BSDF layer1_out = layer(dielectric_brdf1_out, mybsdf1_out);
    surfaceshader surface1_out = surfaceshader(null_closure(), null_closure(), 1.0);
    mx_surface(layer1_out, null_closure(), surface1_opacity, surface1_thin_walled, surface1_out);
    MATERIAL _surfacematerial__out = null_closure();
    mx_surfacematerial(surface1_out, surfaceshader(null_closure(), null_closure(), 1.0), vector(0.0), _surfacematerial__out);
    out1 = _surfacematerial__out;
}

