#include "mx_funcs.h"

#define true 1
#define false 0
struct textureresource { string filename; string colorspace; };
#define BSDF closure color
#define EDF closure color
#define VDF closure color
struct surfaceshader { closure color bsdf; closure color edf; float opacity; };
#define volumeshader closure color
#define displacementshader vector
#define lightshader closure color
#define MATERIAL closure color

#define M_FLOAT_EPS 1e-8
closure color null_closure() { closure color null_closure = 0; return null_closure; } 

void mx_dielectric_bsdf(float weight, color tint, float ior, vector2 roughness, int retroreflective, float thinfilm_thickness, float thinfilm_ior, normal N, vector U, string distribution, string scatter_mode, output BSDF bsdf)
{
    color reflection_tint = (scatter_mode == "T") ? color(0.0) : tint;
    color transmission_tint = (scatter_mode == "R") ? color(0.0) : tint;
    bsdf = weight * dielectric_bsdf(N, U, reflection_tint, transmission_tint, roughness.x, roughness.y, ior, distribution, "thinfilm_thickness", thinfilm_thickness, "thinfilm_ior", thinfilm_ior);
}

void NG_scaled_layer(BSDF top, BSDF base, float scale_top, float scale_base, float scale_layer, output BSDF out)
{
    BSDF top_scaled_out = (scale_top * top);
    BSDF base_scaled_out = (scale_base * base);
    BSDF layer_out = layer(top_scaled_out, base_scaled_out);
    BSDF layer_scaled_out = (scale_layer * layer_out);
    out = layer_scaled_out;
}

void mx_surface(BSDF bsdf, EDF edf, float opacity, int thin_walled, output surfaceshader result)
{
    result.bsdf    = bsdf;
    result.edf     = edf;
    result.opacity = clamp(opacity, 0.0, 1.0);
}

void mx_surfacematerial(surfaceshader surface, surfaceshader back, displacementshader disp, output MATERIAL result)
{
    float opacity_weight = clamp(surface.opacity, 0.0, 1.0);
    result =  (surface.bsdf + surface.edf) * opacity_weight + transparent() * (1.0 - opacity_weight);
}

shader out
[[
    string mtlx_category = "output",
    string mtlx_name = "out"
]]
(
    string geomprop_Nworld_space = "world",
    string geomprop_Tworld_space = "world",
    int geomprop_Tworld_index = 0
    [[
        string widget = "number"
    ]],
    float dielectric_weight = 1.000000
    [[
        string widget = "number"
    ]],
    color dielectric_tint = color(1.000000, 1.000000, 1.000000),
    float dielectric_ior = 1.500000
    [[
        string widget = "number"
    ]],
    vector2 dielectric_roughness = {0.050000, 0.050000},
    int dielectric_retroreflective = 0
    [[
        string widget = "checkBox"
    ]],
    float dielectric_thinfilm_thickness = 0.000000
    [[
        string widget = "number"
    ]],
    float dielectric_thinfilm_ior = 1.500000
    [[
        string widget = "number"
    ]],
    string dielectric_distribution = "ggx",
    string dielectric_scatter_mode = "R",
    float conductor_weight = 1.000000
    [[
        string widget = "number"
    ]],
    color conductor_ior = color(0.183000, 0.421000, 1.373000),
    color conductor_extinction = color(3.424000, 2.346000, 1.770000),
    vector2 conductor_roughness = {0.050000, 0.050000},
    int conductor_retroreflective = 0
    [[
        string widget = "checkBox"
    ]],
    float conductor_thinfilm_thickness = 0.000000
    [[
        string widget = "number"
    ]],
    float conductor_thinfilm_ior = 1.500000
    [[
        string widget = "number"
    ]],
    string conductor_distribution = "ggx",
    float custom_layer_scale_top = 0.800000
    [[
        string widget = "number"
    ]],
    float custom_layer_scale_base = 0.300000
    [[
        string widget = "number"
    ]],
    float custom_layer_scale_layer = 0.900000
    [[
        string widget = "number"
    ]],
    float surface1_opacity = 1.000000
    [[
        string widget = "number"
    ]],
    int surface1_thin_walled = 0
    [[
        string widget = "checkBox"
    ]],
    output MATERIAL out1 = 0
)
{
    vector geomprop_Nworld_out1 = transform(geomprop_Nworld_space, N);
    vector geomprop_Tworld_out1 = transform(geomprop_Tworld_space, normalize(dPdu));
    BSDF dielectric_out = null_closure();
    mx_dielectric_bsdf(dielectric_weight, dielectric_tint, dielectric_ior, dielectric_roughness, dielectric_retroreflective, dielectric_thinfilm_thickness, dielectric_thinfilm_ior, geomprop_Nworld_out1, geomprop_Tworld_out1, dielectric_distribution, dielectric_scatter_mode, dielectric_out);
    BSDF conductor_out = conductor_weight * conductor_bsdf(geomprop_Nworld_out1, geomprop_Tworld_out1, conductor_roughness.x, conductor_roughness.y, conductor_ior, conductor_extinction, conductor_distribution, "thinfilm_thickness", conductor_thinfilm_thickness, "thinfilm_ior", conductor_thinfilm_ior);
    BSDF custom_layer_out = null_closure();
    NG_scaled_layer(dielectric_out, conductor_out, custom_layer_scale_top, custom_layer_scale_base, custom_layer_scale_layer, custom_layer_out);
    surfaceshader surface1_out = surfaceshader(null_closure(), null_closure(), 1.0);
    mx_surface(custom_layer_out, null_closure(), surface1_opacity, surface1_thin_walled, surface1_out);
    MATERIAL _surfacematerial__out = null_closure();
    mx_surfacematerial(surface1_out, surfaceshader(null_closure(), null_closure(), 1.0), vector(0.0), _surfacematerial__out);
    out1 = _surfacematerial__out;
}

