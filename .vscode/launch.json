                "${workspaceFolder}/contrib/tests/metashade_ref/libraries",
                "--path",
                "${workspaceFolder}/build/installed/libraries/pbrlib/genglsl",
                "--path",
                "${workspaceFolder}/build/installed/libraries/stdlib/genglsl",
                "--library", "standard_surface",
                "--material",
                "resources/Materials/Examples/StandardSurface/standard_surface_greysphere.mtlx",
                "--screenWidth", "1920",
                "--screenHeight", "1080",
                "--frameTiming", "true"
